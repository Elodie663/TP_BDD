{% extends 'base.html.twig' %}

{% block title %}Cage index{% endblock %}

{% block body %}

  <style>
    body {
      background-color: #ffffff;
    }

    h1 {
      text-align: center;
      margin-bottom: 30px;
    }

    .table {
      width: 90%;
      margin: 0 auto 30px auto;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    .table th, .table td {
      border: 1px solid #ccc;
      padding: 10px 15px;
      text-align: center;
    }

    .table thead {
      background-color: #267c60;
      color: white;
    }

    a {
      color: #7bdeaeff;
      text-decoration: none;
      margin: 0 5px;
      font-weight: bold;
    }

    a:hover {
      color: #060303ff;
    }

    .create-button {
      display: block;
      width: fit-content;
      margin: 20px auto;
      padding: 10px 20px;
      background-color: #7bdeaeff;
      color: #ffffffff;
      border-radius: 5px;
      text-align: center;
    }

    .badge {
      padding: 5px 10px;
      border-radius: 5px;
      font-size: 0.9em;
      font-weight: bold;
      display: inline-block;
      margin-bottom: 5px;
    }

    .bg-success {
      background-color: #7bdeaeff;
      color: white;
    }

    .bg-secondary {
      background-color: #ff4a4aff;
      color: white;
    }

    .btn-success {
      background-color: #7bdeaeff;
      border: none;
      color: white;
      padding: 5px 10px;
      font-size: 0.9em;
      border-radius: 5px;
      display: inline-block;
      text-decoration: none;
    }

    .btn-success:hover {
      background-color: #7bdeaeff;
    }
  </style>


    <h1>Cage index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Numero_cage</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for cage in cages %}
            <tr>
                <td>{{ cage.id }}</td>
                <td>{{ cage.numeroCage }}</td>
                <td>
                    <a href="{{ path('app_cage_show', {'id': cage.id}) }}">show</a>
                    <a href="{{ path('app_cage_edit', {'id': cage.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_cage_new') }}">Create new</a>

{% endblock %}
