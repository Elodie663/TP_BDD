{% extends 'base.html.twig' %}

{% block title %}Adoption{% endblock %}

{% block body %}
    <h1>Adoption</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ adoption.id }}</td>
            </tr>
            <tr>
                <th>Date_adoption</th>
                <td>{{ adoption.dateAdoption ? adoption.dateAdoption|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Prix_adoption</th>
                <td>{{ adoption.prixAdoption }}</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td>{{ adoption.statut }}</td>
            </tr>
            <tr>
                <th>Adoptant</th>
                <td>{{ adoption.adoptant.nom }} {{ adoption.adoptant.prenom }}</td>
            </tr>
            <tr>
                <th>Animal</th>
                <td>{{ adoption.animal.nomAnimal }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_adoption_index') }}">back to list</a>

    <a href="{{ path('app_adoption_edit', {'id': adoption.id}) }}">edit</a>

    {{ include('adoption/_delete_form.html.twig') }}
{% endblock %}
