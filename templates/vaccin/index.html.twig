{% extends 'base.html.twig' %}

{% block title %}Vaccin index{% endblock %}

{% block body %}
    <h1>Vaccin index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom_vaccin</th>
                <th>Type_vaccin</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for vaccin in vaccins %}
            <tr>
                <td>{{ vaccin.id }}</td>
                <td>{{ vaccin.nomVaccin }}</td>
                <td>{{ vaccin.typeVaccin }}</td>
                <td>
                    <a href="{{ path('app_vaccin_show', {'id': vaccin.id}) }}">show</a>
                    <a href="{{ path('app_vaccin_edit', {'id': vaccin.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_vaccin_new') }}">Create new</a>
{% endblock %}
