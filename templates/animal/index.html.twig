{% extends 'base.html.twig' %}

{% block title %}Animal index{% endblock %}

{% block body %}
    <h1>Animal index</h1>


    <table class="table table-striped table-hover">
        <thead class="table-warning">
            <tr>
                <th>Id</th>
                <th>Nom_animal</th>
                <th>Race</th>
                <th>Sexe</th>
                <th>Date_naissance</th>
                <th>Date_arrivee</th>
                <th>Domestique_sauvage</th>
                <th>Adoptable</th>
                <th>actions</th>
                <th>Adoptable</th>
            </tr>
        </thead>
        <tbody>
        {% for animal in animals %}
            <tr>
                <td>{{ animal.id }}</td>
                <td>{{ animal.nomAnimal }}</td>
                <td>{{ animal.race }}</td>
                <td>{{ animal.sexe }}</td>
                <td>{{ animal.dateNaissance ? animal.dateNaissance|date('Y-m-d') : '' }}</td>
                <td>{{ animal.dateArrivee ? animal.dateArrivee|date('Y-m-d') : '' }}</td>
                <td>{{ animal.domestiqueSauvage }}</td>
                <td>{{ animal.adoptable ? 'Yes' : 'No' }}</td>
                <td>
                    <a href="{{ path('app_animal_show', {'id': animal.id}) }}">show</a>
                    <a href="{{ path('app_animal_edit', {'id': animal.id}) }}">edit</a>
    
                <td>
<!--condition yes ou non-->
                {% if animal.adoptable %}
                <span class="badge bg-success">Yes</span>
                                    <a href="{{ path('app_adoption_new', {'id': animal.id}) }}" class="btn btn-success btn-sm">
                    Adopter
                    </a>
                    {% else %}
                        <span class="badge bg-secondary">No</span>
                    {% endif %}
                    
  
            </tr>
        {% else %}
            <tr>
                <td colspan="9">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_animal_new') }}">Create new</a>
{% endblock %}
