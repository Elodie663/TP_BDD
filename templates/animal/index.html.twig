{% extends 'base.html.twig' %}

{% block title %}Animal index{% endblock %}

{% block body %}

  <style>
    body {
      background-color: #ffffff;
    }

    h1 {
      text-align: center;
      margin-bottom: 30px;
    }

    .table {
      width: 90%;
      margin: 0 auto 30px auto;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    .table th, .table td {
      border: 1px solid #ccc;
      padding: 10px 15px;
      text-align: center;
    }

    .table thead {
      background-color: #267c60;
      color: white;
    }

    a {
      color: #7bdeaeff;
      text-decoration: none;
      margin: 0 5px;
      font-weight: bold;
    }

    a:hover {
      color: #060303ff;
    }

    .create-button {
      display: block;
      width: fit-content;
      margin: 20px auto;
      padding: 10px 20px;
      background-color: #7bdeaeff;
      color: #ffffffff;
      border-radius: 5px;
      text-align: center;
    }

    .badge {
      padding: 5px 10px;
      border-radius: 5px;
      font-size: 0.9em;
      font-weight: bold;
      display: inline-block;
    }

    .bg-success {
      background-color: #7bdeaeff;
      color: white;
    }

    .bg-secondary {
      background-color: #ff4a4aff;
      color: white;
    }

    .btn-success {
      background-color: #7bdeaeff;
      border: none;
      color: white;
      padding: 5px 10px;
      font-size: 0.9em;
      border-radius: 5px;
      display: inline-block;
    }

    .btn-success:hover {
      background-color: #7bdeaeff;
    }
  </style>

  <h1>Animal index</h1>

  <table class="table">
    <thead>
      <tr>
        <th>Id</th>
        <th>Nom_animal</th>
        <th>Race</th>
        <th>Sexe</th>
        <th>Date_naissance</th>
        <th>Date_arrivee</th>
        <th>Domestique_sauvage</th>
        <th>Adoptable</th>
        <th>Actions</th>
        <th>Adoption</th>
      </tr>
    </thead>
    <tbody>
      {% for animal in animals %}
        <tr>
          <td>{{ animal.id }}</td>
          <td>{{ animal.nomAnimal }}</td>
          <td>{{ animal.race }}</td>
          <td>{{ animal.sexe }}</td>
          <td>{{ animal.dateNaissance ? animal.dateNaissance|date('Y-m-d') : '' }}</td>
          <td>{{ animal.dateArrivee ? animal.dateArrivee|date('Y-m-d') : '' }}</td>
          <td>{{ animal.domestiqueSauvage }}</td>
          <td>{{ animal.adoptable ? 'Yes' : 'No' }}</td>
          <td>
            <a href="{{ path('app_animal_show', {'id': animal.id}) }}">Afficher</a>
            <a href="{{ path('app_animal_edit', {'id': animal.id}) }}">Modifier</a>
          </td>
          <td>
            {% if animal.adoptable %}
              <span style="display: inline-flex; align-items: center; gap: 8px;">
                <span class="badge bg-success">Yes</span>
                <a href="{{ path('app_adoption_new', {'id': animal.id}) }}" class="btn-success">
                  Adopter
                </a>
              </span>
            {% else %}
              <span class="badge bg-secondary">No</span>
            {% endif %}
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="10">Aucun enregistrement trouvé</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>

  <a href="{{ path('app_animal_new') }}" class="create-button">Créer un nouvel animal</a>

