{% extends 'base.html.twig' %}

{% block title %}Animal{% endblock %}

{% block body %}

  <style>
    h1 {
      text-align: center;
      margin-bottom: 30px;
    }

    .table {
      width: 80%;
      margin: 0 auto 30px auto;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      background: linear-gradient(to bottom, #d03258, #e36e8f, #ffffff);
      border-collapse: collapse;
      border-radius: 8px;
      overflow: hidden;
    }

    .table th, .table td {
      border: 1px solid rgba(0, 0, 0, 0.1);
      padding: 10px 15px;
      text-align: center;
      background-color: rgba(255, 255, 255, 0.8);
    }

    a {
      display: inline-block;
      margin: 0 10px;
      color: #7bdeae;
      text-decoration: none;
      font-weight: bold;
    }

    a:hover {
      color: #060303;
    }

    .actions {
      text-align: center;
      margin-bottom: 30px;
    }
  </style>

  <h1>Animal</h1>

  <table class="table">
    <tbody>
      <tr>
        <th>Id</th>
        <td>{{ animal.id }}</td>
      </tr>
      <tr>
        <th>Nom_animal</th>
        <td>{{ animal.nomAnimal }}</td>
      </tr>
      <tr>
        <th>Race</th>
        <td>{{ animal.race }}</td>
      </tr>
      <tr>
        <th>Sexe</th>
        <td>{{ animal.sexe }}</td>
      </tr>
      <tr>
        <th>Date_naissance</th>
        <td>{{ animal.dateNaissance ? animal.dateNaissance|date('Y-m-d') : '' }}</td>
      </tr>
      <tr>
        <th>Date_arrivee</th>
        <td>{{ animal.dateArrivee ? animal.dateArrivee|date('Y-m-d') : '' }}</td>
      </tr>
      <tr>
        <th>Domestique_sauvage</th>
        <td>{{ animal.domestiqueSauvage }}</td>
      </tr>
      <tr>
        <th>Adoptable</th>
        <td>{{ animal.adoptable ? 'Yes' : 'No' }}</td>
      </tr>
    </tbody>
  </table>

  <div class="actions">
    <a href="{{ path('app_animal_index') }}">back to list</a>
    <a href="{{ path('app_animal_edit', {'id': animal.id}) }}">edit</a>
    {{ include('animal/_delete_form.html.twig') }}
  </div>

