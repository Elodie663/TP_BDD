{% extends 'base.html.twig' %}

{% block title %}CarnetSante index{% endblock %}

{% block body %}

  <style>
    body {
      background-color: #ffffff;
    }

    h1 {
      text-align: center;
      margin-bottom: 30px;
    }

    .table {
      width: 90%;
      margin: 0 auto 30px auto;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    .table th, .table td {
      border: 1px solid #ccc;
      padding: 10px 15px;
      text-align: center;
    }

    a {
      color: #7bdeaeff;
      text-decoration: none;
      margin: 0 5px;
      font-weight: bold;
    }

    a:hover {
      color: #060303ff;
    }

    .create-button {
      display: block;
      width: fit-content;
      margin: 20px auto;
      padding: 10px 20px;
      background-color: #7bdeaeff;
      color: #ffffffff;
      border-radius: 5px;
      text-align: center;
    }
  </style>

  <h1>Carnet de Sante</h1>

  <table class="table">
    <thead>
      <tr>
        <th>Id</th>
        <th>Date_creation</th>
        <th>Observations_generales</th>
        <th>actions</th>
      </tr>
    </thead>
    <tbody>
      {% for carnet_sante in carnet_santes %}
        <tr>
          <td>{{ carnet_sante.id }}</td>
          <td>{{ carnet_sante.dateCreation ? carnet_sante.dateCreation|date('Y-m-d') : '' }}</td>
          <td>{{ carnet_sante.observationsGenerales }}</td>
          <td>
            <a href="{{ path('app_carnet_sante_show', {'id': carnet_sante.id}) }}">show</a>
            <a href="{{ path('app_carnet_sante_edit', {'id': carnet_sante.id}) }}">edit</a>
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="4">no records found</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>

  <a href="{{ path('app_carnet_sante_new') }}" class="create-button">Create new</a>

 
{% endblock %}
