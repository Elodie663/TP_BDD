{% extends 'base.html.twig' %}

{% block title %}Adptant index{% endblock %}

{% block body %}

  <style>
    body {
      background-color: #ffffff;
    }

    h1 {
      text-align: center;
      margin-bottom: 30px;
    }

    .table {
      width: 90%;
      margin: 0 auto 30px auto;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    .table th, .table td {
      border: 1px solid #ccc;
      padding: 10px 15px;
      text-align: center;
    }

    .table thead {
      background-color: #267c60;
      color: white;
    }

    a {
      color: #7bdeaeff;
      text-decoration: none;
      margin: 0 5px;
      font-weight: bold;
    }

    a:hover {
      color: #060303ff;
    }

    .create-button {
      display: block;
      width: fit-content;
      margin: 20px auto;
      padding: 10px 20px;
      background-color: #7bdeaeff;
      color: #ffffffff;
      border-radius: 5px;
      text-align: center;
      text-decoration: none;
    }
  </style>

  <h1>Adptant index</h1>

  <table class="table">
    <thead>
      <tr>
        <th>Id</th>
        <th>Nom_adoptant</th>
        <th>Prenom_adoptant</th>
        <th>Adresse_adoptant</th>
        <th>Telephone_adoptant</th>
        <th>Genre_animal_souhaite</th>
        <th>actions</th>
      </tr>
    </thead>
    <tbody>
      {% for adptant in adptants %}
        <tr>
          <td>{{ adptant.id }}</td>
          <td>{{ adptant.nomAdoptant }}</td>
          <td>{{ adptant.prenomAdoptant }}</td>
          <td>{{ adptant.adresseAdoptant }}</td>
          <td>{{ adptant.telephoneAdoptant }}</td>
          <td>{{ adptant.genreAnimalSouhaite }}</td>
          <td>
            <a href="{{ path('app_adptant_show', {'id': adptant.id}) }}">show</a>
            <a href="{{ path('app_adptant_edit', {'id': adptant.id}) }}">edit</a>
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="7">no records found</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>

  <a href="{{ path('app_adptant_new') }}" class="create-button">Create new</a>

