{% extends 'base.html.twig' %}

{% block title %}Animaux à l'adoption{% endblock %}

{% block body %}
<style>
    .example-wrapper {
        margin: 1em auto;
        max-width: 1200px;
        width: 95%;
        font: 18px/1.5 sans-serif;
    }
    .example-wrapper code {
        background: #F5F5F5;
        padding: 2px 6px;
    }
</style>

<div class="example-wrapper">
    <h1>Animaux à l'adoption</h1>
    <div class="container mt-5">
        <div class="row">
            {% for animal in animaux %}
                <div class="col-md-4 mb-3">
                    <div class="card">
                        <div class="card-body">
                            <h2 class="card-title">{{ animal.nomAnimal }}</h2>
                            <p class="card-text">
                                {{ animal.race }} - {{ animal.sexe }}
                            </p>
                            <a href="{{ path('app_animal_show', {'id': animal.id}) }}" class="btn btn-primary btn-sm">
                                Afficher détails
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}