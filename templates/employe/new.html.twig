{% extends 'base.html.twig' %}

{% block title %}New Employe{% endblock %}

{% block body %}

  <style>
    .content-wrapper {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 80vh;
      padding: 20px;
      box-sizing: border-box;
    }

    h1 {
      margin-bottom: 30px;
      text-align: center;
    }

    form {
      width: 100%;
      max-width: 500px;
      margin-bottom: 20px;
    }

    /* Ajout d'espace entre chaque champ de formulaire */
    form > div {
      margin-bottom: 15px;
    }

    /* Style bouton save */
    form button[type="submit"] {
      background-color: #7bdeaeff;
      color: #fff;
      border: none;
      padding: 10px 25px;
      font-size: 1rem;
      border-radius: 5px;
      cursor: pointer;
      font-weight: bold;
      transition: background-color 0.3s ease;
    }

    form button[type="submit"]:hover {
      background-color: #60c995ff; /* un vert un peu plus foncé au hover */
    }

    a {
      color: #7bdeaeff;
      text-decoration: none;
      font-weight: bold;
      margin-top: 10px;
    }

    a:hover {
      color: #060303ff;
    }
  </style>

  <div class="content-wrapper">

    <h1>Create new Employe</h1>

    {{ include('employe/_form.html.twig') }}

    <a href="{{ path('app_employe_index') }}">back to list</a>

  </div>

{% endblock %}
